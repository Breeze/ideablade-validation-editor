{
  "name": "ideablade-validation-editor",
  "productName": "IdeaBlade Validation Editor",
  "version": "0.1.0-alpha.2",
  "description": "Desktop editor for IdeaBlade Validation's JSON validation metadata.",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/Breeze/ideablade-validation-editor",
  "repository": {
    "type": "git",
    "url": "https://github.com/Breeze/ideablade-validation-editor.git"
  },
  "author": "IdeaBlade",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=26.13"
  },
  "scripts": {
    "ng": "ng",
    "prebuild": "node scripts/build-schema-validator.mjs",
    "build": "ng build",
    "build:electron": "node -e \"require('fs').rmSync('dist-electron', { recursive: true, force: true })\" && tsc -p tsconfig.electron.json",
    "start": "npm run build && npm run build:electron && electron .",
    "dev": "node scripts/build-schema-validator.mjs && npm run build:electron && node scripts/dev.mjs",
    "test": "node scripts/build-schema-validator.mjs && ng test --watch=false && npm run build:electron && node scripts/test-main.mjs",
    "dist": "npm run build && npm run build:electron && electron-builder --win nsis",
    "dist:dir": "npm run build && npm run build:electron && electron-builder --win dir",
    "dist:mac": "npm run build && npm run build:electron && electron-builder --mac dmg --x64 --arm64",
    "dist:linux": "npm run build && npm run build:electron && electron-builder --linux AppImage deb",
    "icon": "electron scripts/build-icon.cjs"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "electron-updater": "^6.8.11",
    "typescript": "~6.0.2"
  },
  "devDependencies": {
    "@angular/build": "22.3",
    "@angular/cli": "22.3",
    "@angular/common": "22.3",
    "@angular/compiler": "22.3",
    "@angular/compiler-cli": "22.3",
    "@angular/core": "22.3",
    "@angular/forms": "22.3",
    "@angular/platform-browser": "22.3",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@eslint-community/regexpp": "^4.12.3",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "ideablade-validation": "^0.1.0",
    "jsdom": "^31.0.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.9.1",
    "vitest": "^5.1.1"
  },
  "build": {
    "appId": "com.ideablade.validation-editor",
    "productName": "IdeaBlade Validation Editor",
    "artifactName": "IdeaBlade-Validation-Editor-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/**/*.test.js",
      "package.json",
      "build/icon.ico",
      "build/icon.png"
    ],
    "afterPack": "scripts/adhoc-sign-mac.cjs",
    "publish": [
      {
        "provider": "github",
        "owner": "Breeze",
        "repo": "ideablade-validation-editor"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "selectPerMachineByDefault": true,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "IdeaBlade-Validation-Editor-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "IdeaBlade",
      "synopsis": "Editor for IdeaBlade Validation metadata"
    },
    "fileAssociations": [
      {
        "ext": "ivproj",
        "name": "IdeaBlade Validation Project",
        "description": "IdeaBlade Validation Project",
        "role": "Editor",
        "mimeType": "application/x-ideablade-validation-project"
      }
    ]
  }
}
