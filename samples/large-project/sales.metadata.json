{
  "$schema": "https://raw.githubusercontent.com/Breeze/ideablade-validation/main/spec/validation-metadata.schema.json",
  "$comment": "Test metadata: sales, generated by generate.cjs.",
  "global": {
    "validators": [
      "breeze"
    ]
  },
  "Customer": {
    "properties": {
      "status": {
        "required": true,
        "maxLength": 30
      },
      "url": {
        "required": true,
        "validators": [
          {
            "name": "pattern",
            "id": "URL_FORMAT",
            "context": {
              "expression": "^https?://\\S+$",
              "flags": "i",
              "messageTemplate": "'%displayName%' must be a web address"
            }
          }
        ]
      },
      "notes": {
        "required": true,
        "maxLength": 2000
      },
      "startDate": {
        "validators": [
          {
            "name": "date"
          }
        ]
      }
    }
  },
  "CustomerAddress": {
    "properties": {
      "phone": {
        "validators": [
          {
            "name": "phone"
          }
        ]
      },
      "code": {
        "validators": [
          {
            "name": "pattern",
            "id": "CODE_FORMAT",
            "context": {
              "expression": "^[A-Z]{2,4}-\\d{3,6}$",
              "messageTemplate": "'%displayName%' must look like AB-123"
            }
          }
        ]
      },
      "status": {
        "required": true,
        "maxLength": 50
      }
    }
  },
  "CustomerContact": {
    "condition": "!model.isDeleted",
    "properties": {
      "notes": {
        "maxLength": 30
      },
      "priority": {
        "required": true,
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          }
        ]
      }
    }
  },
