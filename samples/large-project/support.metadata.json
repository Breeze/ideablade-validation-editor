  "$comment": "Test metadata: support, generated by generate.cjs.",
  "Ticket": {
    "properties": {
      "email": {
        "required": true,
        "validators": [
          {
            "name": "email"
          }
        ]
      },
      "endDate": {
        "required": true,
        "validators": [
          {
            "name": "date"
          }
        ]
      },
      "phone": {
        "required": true,
        "validators": [
          {
            "name": "phone"
          }
        ]
      },
      "url": {
        "validators": [
          {
            "name": "pattern",
            "id": "URL_FORMAT",
            "context": {
              "expression": "^https?://\\S+$",
              "flags": "i",
              "messageTemplate": "'%displayName%' must be a web address"
            }
          }
        ]
      }
    }
  },
  "TicketComment": {
    "properties": {
      "description": {
