{
  "$schema": "https://raw.githubusercontent.com/Breeze/ideablade-validation/main/spec/validation-metadata.schema.json",
  "$comment": "Test metadata: assets, generated by generate.cjs.",
  "Asset": {
    "properties": {
      "zipcode": {
        "validators": [
          {
            "name": "zipCode"
          }
        ]
      },
      "url": {
        "required": true,
        "validators": [
          {
            "name": "pattern",
            "id": "URL_FORMAT",
            "context": {
              "expression": "^https?://\\S+$",
              "flags": "i",
              "messageTemplate": "'%displayName%' must be a web address"
            }
          }
        ]
      },
      "email": {
        "required": true,
        "validators": [
          {
            "name": "email"
          }
        ]
      }
    }
  },
  "AssetType": {
    "properties": {
      "priority": {
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          }
        ]
      },
      "amount": {
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          },
          {
            "name": "range",
            "context": {
              "minValue": 0
            }
          }
        ]
      }
    }
  },
