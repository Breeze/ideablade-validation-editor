{
  "$schema": "https://raw.githubusercontent.com/Breeze/ideablade-validation/main/spec/validation-metadata.schema.json",
  "$comment": "Test metadata: billing, generated by generate.cjs.",
  "Invoice": {
    "properties": {
      "phone": {
        "validators": [
          {
            "name": "phone"
          }
        ]
      },
      "endDate": {
        "required": true,
        "validators": [
          {
            "name": "date"
          }
        ]
      },
      "notes": {
        "required": true,
        "maxLength": 30
      }
    }
  },
  "InvoiceLine": {
    "properties": {
      "endDate": {
        "required": true,
        "validators": [
          {
            "name": "date"
          }
        ]
      },
      "status": {
        "required": true,
        "maxLength": 30
      },
      "reference": {
        "required": true,
        "maxLength": 250
      },
      "name": {
        "maxLength": 2000
      }
    }
  },
  "CreditNote": {
    "properties": {
      "name": {
        "required": true,
        "maxLength": 30
      },
      "reference": {
        "required": true,
        "maxLength": 30
      },
      "endDate": {
        "validators": [
          {
            "name": "date"
          }
        ]
      },
      "phone": {
        "required": true,
        "validators": [
          {
            "name": "phone"
          }
        ]
      }
    }
  },
  "CreditNoteLine": {
    "properties": {
      "description": {
        "required": true,
        "maxLength": 50
      },
      "name": {
        "maxLength": 50
      },
      "reference": {
        "maxLength": 2000
      },
      "url": {
        "validators": [
          {
            "name": "pattern",
            "id": "URL_FORMAT",
            "context": {
              "expression": "^https?://\\S+$",
              "flags": "i",
              "messageTemplate": "'%displayName%' must be a web address"
            }
          }
        ]
      }
    }
  },
  "Payment": {
    "properties": {
      "name": {
        "maxLength": 30
      },
      "amount": {
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          }
        ]
      }
    }
  },
  "PaymentMethod": {
    "properties": {
      "phone": {
        "validators": [
          {
            "name": "phone"
          }
        ]
      },
      "quantity": {
        "required": true,
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          }
        ]
      }
    }
  },
  "PaymentTerm": {
    "properties": {
      "status": {
        "required": true,
        "maxLength": 2000
      },
      "code": {
        "validators": [
          {
            "name": "pattern",
            "id": "CODE_FORMAT",
            "context": {
              "expression": "^[A-Z]{2,4}-\\d{3,6}$",
              "messageTemplate": "'%displayName%' must look like AB-123"
            }
          }
        ]
      },
      "url": {
        "validators": [
          {
            "name": "pattern",
            "id": "URL_FORMAT",
            "context": {
              "expression": "^https?://\\S+$",
              "flags": "i",
              "messageTemplate": "'%displayName%' must be a web address"
            }
          }
        ]
      }
    }
  },
  "TaxRate": {
    "properties": {
      "url": {
        "required": true,
        "validators": [
          {
            "name": "pattern",
            "id": "URL_FORMAT",
            "context": {
              "expression": "^https?://\\S+$",
              "flags": "i",
              "messageTemplate": "'%displayName%' must be a web address"
            }
          }
        ]
      },
      "priority": {
        "required": true,
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          },
          {
            "name": "range",
            "context": {
              "minValue": 0
            }
          }
        ]
      },
      "code": {
        "validators": [
          {
            "name": "pattern",
            "id": "CODE_FORMAT",
            "context": {
              "expression": "^[A-Z]{2,4}-\\d{3,6}$",
              "messageTemplate": "'%displayName%' must look like AB-123"
            }
          }
        ]
      },
      "startDate": {
        "required": true,
        "validators": [
          {
            "name": "date"
          }
        ]
      }
    }
  },
  "TaxExemption": {
    "properties": {
      "quantity": {
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          }
        ]
      },
      "email": {
        "validators": [
          {
            "name": "email"
          }
        ]
      },
      "percentage": {
        "required": true,
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          },
          {
            "name": "range",
            "context": {
              "minValue": 0,
              "maxValue": 100
            }
          }
        ]
      },
      "code": {
        "validators": [
          {
            "name": "pattern",
            "id": "CODE_FORMAT",
            "context": {
              "expression": "^[A-Z]{2,4}-\\d{3,6}$",
              "messageTemplate": "'%displayName%' must look like AB-123"
            }
          }
        ]
      }
    }
  },
  "Currency": {
    "properties": {
      "zipcode": {
        "validators": [
          {
            "name": "zipCode"
          }
        ]
      },
      "quantity": {
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          },
          {
            "name": "range",
            "context": {
              "minValue": 0
            }
          }
        ]
      },
      "code": {
        "validators": [
          {
            "name": "pattern",
            "id": "CODE_FORMAT",
            "context": {
              "expression": "^[A-Z]{2,4}-\\d{3,6}$",
              "messageTemplate": "'%displayName%' must look like AB-123"
            }
          }
        ]
      },
      "status": {
        "required": true,
        "maxLength": 2000
      }
    }
  },
  "ExchangeRate": {
    "properties": {
      "name": {
        "maxLength": 30
      },
      "zipcode": {
        "validators": [
          {
            "name": "zipCode"
          }
        ]
      },
      "priority": {
        "required": true,
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          }
        ]
      },
      "description": {
        "maxLength": 250
      }
    }
  },
  "BillingAccount": {
    "properties": {
      "email": {
        "validators": [
          {
            "name": "email"
          }
        ]
      },
      "zipcode": {
        "validators": [
          {
            "name": "zipCode"
          }
        ]
      }
    }
  },
  "Statement": {
    "properties": {
      "status": {
        "required": true,
        "maxLength": 50
      },
      "priority": {
        "required": true,
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          },
          {
            "name": "range",
            "context": {
              "minValue": 0
            }
          }
        ]
      },
      "description": {
        "maxLength": 2000
      },
      "reference": {
        "required": true,
        "maxLength": 50
      }
    }
  },
  "StatementLine": {
    "properties": {
      "phone": {
        "required": true,
        "validators": [
          {
            "name": "phone"
          }
        ]
      },
      "name": {
        "maxLength": 250
      },
      "quantity": {
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          },
          {
            "name": "range",
            "context": {
              "minValue": 0
            }
          }
        ]
      }
    }
  },
  "Refund": {
    "properties": {
      "email": {
        "required": true,
        "validators": [
          {
            "name": "email"
          }
        ]
      },
      "reference": {
        "maxLength": 50
      },
      "description": {
        "required": true,
        "maxLength": 2000
      }
    }
  },
  "Dunning": {
    "condition": "!model.isDeleted",
    "properties": {
      "endDate": {
        "validators": [
          {
            "name": "date"
          }
        ]
      },
      "priority": {
        "required": true,
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          }
        ]
      },
      "email": {
        "validators": [
          {
            "name": "email"
          }
        ]
      }
    }
  },
  "LateFee": {
    "condition": "!model.isDeleted",
    "properties": {
      "code": {
        "required": true,
        "validators": [
          {
            "name": "pattern",
            "id": "CODE_FORMAT",
            "context": {
              "expression": "^[A-Z]{2,4}-\\d{3,6}$",
              "messageTemplate": "'%displayName%' must look like AB-123"
            }
          }
        ]
      },
      "description": {
        "maxLength": 250
      },
      "reference": {
        "required": true,
        "maxLength": 50
      },
      "status": {
        "required": true,
        "maxLength": 30
      },
      "priority": {
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          }
        ]
      }
    }
  },
  "WriteOff": {
    "properties": {
      "amount": {
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          }
        ]
      },
      "email": {
        "validators": [
          {
            "name": "email"
          }
        ]
      },
      "url": {
        "validators": [
          {
            "name": "pattern",
            "id": "URL_FORMAT",
            "context": {
              "expression": "^https?://\\S+$",
              "flags": "i",
              "messageTemplate": "'%displayName%' must be a web address"
            }
          }
        ]
      },
      "zipcode": {
        "validators": [
          {
            "name": "zipCode"
          }
        ]
      }
    }
  }
}
