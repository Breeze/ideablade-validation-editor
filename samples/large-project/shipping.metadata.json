{
  "$schema": "https://raw.githubusercontent.com/Breeze/ideablade-validation/main/spec/validation-metadata.schema.json",
  "$comment": "Test metadata: shipping, generated by generate.cjs.",
  "Shipment": {
    "properties": {
      "phone": {
        "validators": [
          {
            "name": "phone"
          }
        ]
      },
      "quantity": {
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          },
          {
            "name": "range",
            "context": {
              "minValue": 0
            }
          }
        ]
      },
      "notes": {
        "maxLength": 250
      },
      "amount": {
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          }
        ]
      }
    }
  },
  "ShipmentLine": {
    "properties": {
      "description": {
        "required": true,
        "maxLength": 250
      },
      "priority": {
        "required": true,
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          }
        ]
      }
    }
  },
  "Carrier": {
    "properties": {
      "amount": {
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          },
          {
            "name": "range",
            "context": {
              "minValue": 0
            }
          }
        ]
      },
      "description": {
        "maxLength": 100
      }
    }
  },
  "CarrierService": {
    "properties": {
      "name": {
        "maxLength": 50
      },
      "zipcode": {
        "validators": [
          {
            "name": "zipCode"
          }
        ]
      },
      "notes": {
        "maxLength": 50
      },
      "email": {
        "required": true,
        "validators": [
          {
            "name": "email"
          }
        ]
      }
    }
  },
  "Package": {
    "properties": {
      "code": {
        "required": true,
        "validators": [
          {
            "name": "pattern",
            "id": "CODE_FORMAT",
            "context": {
              "expression": "^[A-Z]{2,4}-\\d{3,6}$",
              "messageTemplate": "'%displayName%' must look like AB-123"
            }
          }
        ]
      },
      "name": {
        "required": true,
        "maxLength": 2000
      },
      "zipcode": {
        "validators": [
          {
            "name": "zipCode"
          }
        ]
      },
      "startDate": {
        "required": true,
        "validators": [
          {
            "name": "date"
          }
        ]
      },
      "amount": {
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          }
        ]
      }
    }
  },
  "PackageItem": {
    "condition": "!model.isDeleted",
    "properties": {
      "url": {
        "validators": [
          {
            "name": "pattern",
            "id": "URL_FORMAT",
            "context": {
              "expression": "^https?://\\S+$",
              "flags": "i",
              "messageTemplate": "'%displayName%' must be a web address"
            }
          }
        ]
      },
      "percentage": {
        "required": true,
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          },
          {
            "name": "range",
            "context": {
              "minValue": 0,
              "maxValue": 100
            }
          }
        ]
      },
      "code": {
        "required": true,
        "validators": [
          {
            "name": "pattern",
            "id": "CODE_FORMAT",
            "context": {
              "expression": "^[A-Z]{2,4}-\\d{3,6}$",
              "messageTemplate": "'%displayName%' must look like AB-123"
            }
          }
        ]
      }
    }
  },
