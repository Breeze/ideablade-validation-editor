{
  "$schema": "https://raw.githubusercontent.com/Breeze/ideablade-validation/main/spec/validation-metadata.schema.json",
  "$comment": "Test metadata: projects, generated by generate.cjs.",
  "Project": {
    "properties": {
      "url": {
        "validators": [
          {
            "name": "pattern",
            "id": "URL_FORMAT",
            "context": {
              "expression": "^https?://\\S+$",
              "flags": "i",
              "messageTemplate": "'%displayName%' must be a web address"
            }
          }
        ]
      },
      "zipcode": {
        "validators": [
          {
            "name": "zipCode"
          }
        ]
      },
      "code": {
        "validators": [
          {
            "name": "pattern",
            "id": "CODE_FORMAT",
            "context": {
              "expression": "^[A-Z]{2,4}-\\d{3,6}$",
              "messageTemplate": "'%displayName%' must look like AB-123"
            }
          }
        ]
      }
    }
  },
  "ProjectPhase": {
    "properties": {
      "notes": {
        "maxLength": 250
      },
      "priority": {
        "required": true,
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          },
          {
            "name": "range",
            "context": {
              "minValue": 0
            }
          }
        ]
      },
      "zipcode": {
        "required": true,
        "validators": [
          {
            "name": "zipCode"
          }
        ]
      }
    }
  },
  "Milestone": {
    "properties": {
      "description": {
        "required": true,
        "maxLength": 30
      },
      "endDate": {
        "validators": [
          {
            "name": "date"
          }
        ]
      }
    }
  },
  "Task": {
    "properties": {
      "priority": {
        "required": true,
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          }
        ]
      },
      "email": {
        "required": true,
        "validators": [
          {
            "name": "email"
          }
        ]
      },
      "description": {
        "required": true,
        "maxLength": 2000
      }
    }
  },
  "TaskDependency": {
    "properties": {
      "reference": {
        "maxLength": 2000
      },
      "description": {
        "maxLength": 30
      },
      "url": {
        "required": true,
        "validators": [
          {
            "name": "pattern",
            "id": "URL_FORMAT",
            "context": {
              "expression": "^https?://\\S+$",
              "flags": "i",
              "messageTemplate": "'%displayName%' must be a web address"
            }
          }
        ]
      },
      "name": {
        "required": true,
        "maxLength": 250
      },
      "email": {
        "required": true,
        "validators": [
          {
            "name": "email"
          }
        ]
      }
    }
  },
  "TaskAssignment": {
    "condition": "!model.isDeleted",
    "properties": {
      "reference": {
        "maxLength": 50
      },
      "priority": {
        "required": true,
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          }
        ]
      },
      "zipcode": {
        "validators": [
          {
            "name": "zipCode"
          }
        ]
      },
      "code": {
        "required": true,
        "validators": [
          {
            "name": "pattern",
            "id": "CODE_FORMAT",
            "context": {
              "expression": "^[A-Z]{2,4}-\\d{3,6}$",
              "messageTemplate": "'%displayName%' must look like AB-123"
            }
          }
        ]
      }
    }
  },
  "TimeEntry": {
    "condition": "!model.isDeleted",
    "properties": {
      "percentage": {
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          },
          {
            "name": "range",
            "context": {
              "minValue": 0,
              "maxValue": 100
            }
          }
        ]
      },
      "startDate": {
        "required": true,
        "validators": [
          {
            "name": "date"
          }
        ]
      },
      "quantity": {
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          },
          {
            "name": "range",
            "context": {
              "minValue": 0
            }
          }
        ]
      }
    }
  },
  "Expense": {
    "properties": {
      "notes": {
        "required": true,
        "maxLength": 50
      },
      "reference": {
        "required": true,
        "maxLength": 50
      },
      "phone": {
        "required": true,
        "validators": [
          {
            "name": "phone"
          }
        ]
      },
      "zipcode": {
        "required": true,
        "validators": [
          {
            "name": "zipCode"
          }
        ]
      },
      "code": {
        "required": true,
        "validators": [
          {
            "name": "pattern",
            "id": "CODE_FORMAT",
            "context": {
              "expression": "^[A-Z]{2,4}-\\d{3,6}$",
              "messageTemplate": "'%displayName%' must look like AB-123"
            }
          }
        ]
      }
    }
  },
  "ExpenseReport": {
    "validators": [
      {
        "name": "expression",
        "id": "END_AFTER_START",
        "propertyNames": [
          "startDate",
          "endDate"
        ],
        "context": {
          "expression": "!model.startDate || !model.endDate || model.endDate >= model.startDate",
          "messageTemplate": "The end date must not be before the start date"
        }
      }
    ],
    "properties": {
      "percentage": {
        "required": true,
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          },
          {
            "name": "range",
            "context": {
              "minValue": 0,
              "maxValue": 100
            }
          }
        ]
      },
      "notes": {
        "maxLength": 250
      },
      "endDate": {
        "required": true,
        "validators": [
          {
            "name": "date"
          }
        ]
      },
      "description": {
        "maxLength": 50
      },
      "startDate": {
        "required": true,
        "validators": [
          {
            "name": "date"
          }
        ]
      }
    }
  },
  "Budget": {
    "condition": "!model.isDeleted",
    "properties": {
      "url": {
        "validators": [
          {
            "name": "pattern",
            "id": "URL_FORMAT",
            "context": {
              "expression": "^https?://\\S+$",
              "flags": "i",
              "messageTemplate": "'%displayName%' must be a web address"
            }
          }
        ]
      },
      "name": {
        "required": true,
        "maxLength": 50
      }
    }
  },
  "BudgetLine": {
    "condition": "!model.isDeleted",
    "properties": {
      "description": {
        "maxLength": 2000
      },
      "name": {
        "maxLength": 250
      },
      "endDate": {
        "required": true,
        "validators": [
          {
            "name": "date"
          }
        ]
      }
    }
  },
  "Risk": {
    "condition": "!model.isDeleted",
    "properties": {
      "quantity": {
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          },
          {
            "name": "range",
            "context": {
              "minValue": 0
            }
          }
        ]
      },
      "status": {
        "required": true,
        "maxLength": 100
      }
    }
  },
  "Issue": {
    "properties": {
      "name": {
        "maxLength": 2000
      },
      "endDate": {
        "validators": [
          {
            "name": "date"
          }
        ]
      },
      "zipcode": {
        "validators": [
          {
            "name": "zipCode"
          }
        ]
      },
      "email": {
        "validators": [
          {
            "name": "email"
          }
        ]
      }
    }
  },
  "ChangeRequest": {
    "properties": {
      "startDate": {
        "validators": [
          {
            "name": "date"
          }
        ]
      },
      "phone": {
        "validators": [
          {
            "name": "phone"
          }
        ]
      }
    }
  },
  "Deliverable": {
    "properties": {
      "percentage": {
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          },
          {
            "name": "range",
            "context": {
              "minValue": 0,
              "maxValue": 100
            }
          }
        ]
      },
      "notes": {
        "required": true,
        "maxLength": 50
      },
      "reference": {
        "required": true,
        "maxLength": 30
      },
      "phone": {
        "required": true,
        "validators": [
          {
            "name": "phone"
          }
        ]
      },
      "code": {
        "validators": [
          {
            "name": "pattern",
            "id": "CODE_FORMAT",
            "context": {
              "expression": "^[A-Z]{2,4}-\\d{3,6}$",
              "messageTemplate": "'%displayName%' must look like AB-123"
            }
          }
        ]
      }
    }
  },
  "Stakeholder": {
    "properties": {
      "email": {
        "required": true,
        "validators": [
          {
            "name": "email"
          }
        ]
      },
      "amount": {
        "required": true,
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          }
        ]
      },
      "code": {
        "required": true,
        "validators": [
          {
            "name": "pattern",
            "id": "CODE_FORMAT",
            "context": {
              "expression": "^[A-Z]{2,4}-\\d{3,6}$",
              "messageTemplate": "'%displayName%' must look like AB-123"
            }
          }
        ]
      }
    }
  }
}
