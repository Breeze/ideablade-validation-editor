      "startDate": {
        "validators": [
          {
            "name": "date"
          }
        ]
      },
      "percentage": {
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          },
          {
            "name": "range",
            "context": {
              "minValue": 0,
              "maxValue": 100
            }
          }
        ]
      }
    }
  },
  "GoodsReceipt": {
    "condition": "!model.isDeleted",
    "properties": {
      "zipcode": {
        "validators": [
          {
            "name": "zipCode"
          }
        ]
      },
      "amount": {
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          }
        ]
      }
    }
  },
  "GoodsReceiptLine": {
    "properties": {
      "priority": {
        "required": true,
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          },
          {
            "name": "range",
            "context": {
              "minValue": 0
            }
          }
        ]
      },
