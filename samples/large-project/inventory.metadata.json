{
  "$schema": "https://raw.githubusercontent.com/Breeze/ideablade-validation/main/spec/validation-metadata.schema.json",
  "$comment": "Test metadata: inventory, generated by generate.cjs.",
  "Product": {
    "properties": {
      "name": {
        "required": true,
        "maxLength": 50
      },
      "amount": {
        "required": true,
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          }
        ]
      }
    }
  },
  "ProductCategory": {
    "properties": {
      "reference": {
        "maxLength": 250
      },
      "notes": {
        "required": true,
        "maxLength": 2000
      },
      "status": {
        "required": true,
        "maxLength": 100
      },
      "name": {
        "required": true,
        "maxLength": 30
      },
      "amount": {
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          }
        ]
      }
    }
  },
  "ProductVariant": {
    "properties": {
      "notes": {
        "maxLength": 2000
      },
      "reference": {
        "required": true,
        "maxLength": 30
      },
      "code": {
        "validators": [
          {
            "name": "pattern",
            "id": "CODE_FORMAT",
            "context": {
              "expression": "^[A-Z]{2,4}-\\d{3,6}$",
              "messageTemplate": "'%displayName%' must look like AB-123"
            }
          }
        ]
      },
      "quantity": {
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          }
        ]
      }
    }
  },
  "StockItem": {
    "properties": {
      "amount": {
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          }
        ]
      },
      "status": {
        "maxLength": 50
      }
    }
  },
  "StockMovement": {
    "properties": {
      "code": {
        "validators": [
          {
            "name": "pattern",
            "id": "CODE_FORMAT",
            "context": {
              "expression": "^[A-Z]{2,4}-\\d{3,6}$",
              "messageTemplate": "'%displayName%' must look like AB-123"
            }
          }
        ]
      },
      "endDate": {
        "required": true,
        "validators": [
          {
            "name": "date"
          }
        ]
      },
      "url": {
        "required": true,
        "validators": [
          {
            "name": "pattern",
            "id": "URL_FORMAT",
            "context": {
              "expression": "^https?://\\S+$",
              "flags": "i",
              "messageTemplate": "'%displayName%' must be a web address"
            }
          }
        ]
      }
    }
  },
  "Warehouse": {
    "properties": {
      "amount": {
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          },
          {
            "name": "range",
            "context": {
              "minValue": 0
            }
          }
        ]
      },
      "priority": {
        "required": true,
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          }
        ]
      },
      "reference": {
        "required": true,
        "maxLength": 100
      },
      "endDate": {
        "required": true,
        "validators": [
          {
            "name": "date"
          }
        ]
      },
      "quantity": {
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          }
        ]
      }
    }
  },
  "WarehouseZone": {
    "properties": {
      "quantity": {
        "required": true,
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          },
          {
            "name": "range",
            "context": {
              "minValue": 0
            }
          }
        ]
      },
      "startDate": {
        "required": true,
        "validators": [
          {
            "name": "date"
          }
        ]
      },
      "reference": {
        "required": true,
        "maxLength": 100
      },
      "amount": {
        "required": true,
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          },
          {
            "name": "range",
            "context": {
              "minValue": 0
            }
          }
        ]
      }
    }
  },
  "Bin": {
    "properties": {
