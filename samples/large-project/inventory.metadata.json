        "required": true,
        "validators": [
          {
            "name": "email"
          }
        ]
      },
      "code": {
        "required": true,
        "validators": [
          {
            "name": "pattern",
            "id": "CODE_FORMAT",
            "context": {
              "expression": "^[A-Z]{2,4}-\\d{3,6}$",
              "messageTemplate": "'%displayName%' must look like AB-123"
            }
          }
        ]
      },
      "reference": {
        "maxLength": 100
      }
    }
  },
  "Supplier": {
    "properties": {
      "notes": {
        "maxLength": 250
      },
      "phone": {
        "validators": [
          {
            "name": "phone"
          }
        ]
      },
      "status": {
        "maxLength": 100
      }
    }
  },
