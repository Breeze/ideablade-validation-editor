      "zipcode": {
        "validators": [
          {
            "name": "zipCode"
          }
        ]
      }
    }
  },
  "Permission": {
    "properties": {
      "percentage": {
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          },
          {
            "name": "range",
            "context": {
              "minValue": 0,
              "maxValue": 100
            }
          }
        ]
      },
      "amount": {
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
