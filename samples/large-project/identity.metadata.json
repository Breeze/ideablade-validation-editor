{
  "$schema": "https://raw.githubusercontent.com/Breeze/ideablade-validation/main/spec/validation-metadata.schema.json",
  "$comment": "Test metadata: identity, generated by generate.cjs.",
  "User": {
    "condition": "!model.isDeleted",
    "properties": {
      "phone": {
        "validators": [
          {
            "name": "phone"
          }
        ]
      },
      "url": {
        "required": true,
        "validators": [
          {
            "name": "pattern",
            "id": "URL_FORMAT",
            "context": {
              "expression": "^https?://\\S+$",
              "flags": "i",
              "messageTemplate": "'%displayName%' must be a web address"
            }
          }
        ]
      }
    }
  },
  "UserProfile": {
    "properties": {
      "name": {
        "required": true,
        "maxLength": 250
      },
      "quantity": {
        "required": true,
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          }
        ]
      }
    }
  },
  "Role": {
    "properties": {
      "endDate": {
        "validators": [
          {
            "name": "date"
          }
        ]
