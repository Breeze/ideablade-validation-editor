{
  "$schema": "https://raw.githubusercontent.com/Breeze/ideablade-validation/main/spec/validation-metadata.schema.json",
  "$comment": "Test metadata: hr, generated by generate.cjs.",
  "Employee": {
    "properties": {
      "reference": {
        "required": true,
        "maxLength": 50
      },
      "phone": {
        "validators": [
          {
            "name": "phone"
          }
        ]
      }
    }
  },
  "EmployeeAddress": {
    "condition": "!model.isDeleted",
    "properties": {
      "startDate": {
        "validators": [
          {
            "name": "date"
          }
        ]
      },
      "description": {
        "required": true,
        "maxLength": 2000
      },
      "name": {
        "required": true,
        "maxLength": 50
      },
      "quantity": {
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          },
          {
            "name": "range",
            "context": {
              "minValue": 0
            }
          }
        ]
      }
    }
  },
  "EmergencyContact": {
    "properties": {
      "priority": {
        "required": true,
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          },
          {
            "name": "range",
            "context": {
              "minValue": 0
            }
          }
        ]
      },
      "name": {
        "maxLength": 250
      },
      "url": {
        "validators": [
          {
            "name": "pattern",
            "id": "URL_FORMAT",
            "context": {
              "expression": "^https?://\\S+$",
              "flags": "i",
              "messageTemplate": "'%displayName%' must be a web address"
            }
          }
        ]
      }
    }
  },
  "Department": {
    "condition": "!model.isDeleted",
    "properties": {
      "name": {
        "maxLength": 2000
      },
      "percentage": {
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
            }
          },
          {
            "name": "range",
            "context": {
              "minValue": 0,
              "maxValue": 100
            }
          }
        ]
      },
      "notes": {
        "maxLength": 2000
      }
    }
  },
  "Position": {
    "properties": {
      "amount": {
        "validators": [
          {
            "name": "numeric",
            "context": {
              "allowDecimals": true
