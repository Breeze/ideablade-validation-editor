{
  "$schema": "https://raw.githubusercontent.com/Breeze/ideablade-validation/main/spec/validation-metadata.schema.json",
  "$comment": "Test metadata for sources taken from folders, generated by generate.cjs.",
  "CustomerForm": {
    "properties": {
      "name": {
        "required": true,
        "maxLength": 50
      },
      "email": {
        "required": true,
        "validators": [
          {
            "name": "email"
          }
        ]
      },
      "phone": {
        "validators": [
          {
            "name": "phone"
          }
        ]
      },
      "notes": {
        "maxLength": 2000
      }
    }
  },
  "LoginForm": {
    "properties": {
      "email": {
        "required": true,
        "validators": [
          {
            "name": "email"
          }
        ]
      },
      "notes": {
        "maxLength": 2000
      }
    }
  },
  "OrderForm": {
    "properties": {
      "code": {
        "required": true,
        "maxLength": 50
      },
      "amount": {
        "required": true,
        "validators": [
          {
            "name": "range",
            "context": {
              "minValue": 0
            }
          }
        ]
      },
      "discount": {
        "validators": [
          {
            "name": "range",
            "context": {
              "minValue": 0
            }
          }
        ]
      },
      "startDate": {
        "required": true
      }
    }
  },
  "ProjectForm": {
    "properties": {
      "name": {
        "required": true,
        "maxLength": 50
      },
      "code": {
        "required": true,
        "maxLength": 50
      },
      "startDate": {
        "required": true
      },
      "endDate": {}
    }
  },
  "CustomerDto": {
    "properties": {
      "name": {
        "required": true,
        "maxLength": 50
      },
      "email": {
        "required": true,
        "validators": [
          {
            "name": "email"
          }
        ]
      },
      "phone": {
        "validators": [
          {
            "name": "phone"
          }
        ]
      },
      "status": {
        "required": true,
        "maxLength": 50
      }
    }
  },
  "OrderDto": {
    "properties": {
      "code": {
        "required": true,
        "maxLength": 50
      },
      "amount": {
        "required": true,
        "validators": [
          {
            "name": "range",
            "context": {
              "minValue": 0
            }
          }
        ]
      },
      "discount": {
        "validators": [
          {
            "name": "range",
            "context": {
              "minValue": 0
            }
          }
        ]
      },
      "startDate": {
        "required": true
      }
    }
  }
}
